# Environment configuration template
# Copy to .env and adjust variables as needed

# Secret key for session management and CSRF protection
SECRET_KEY=change-this-in-production-random-secure-string

# Database URL (Default: SQLite inside instance directory)
# For SQLite: sqlite:////absolute/path/to/instance/hospital.db
# Or leave unset to let the application use the instance folder automatically
DATABASE_URL=

# Flask Environment (production or development)
FLASK_ENV=development
